# Copy to /etc/arena.env (chmod 600) and fill in. Never commit the real file.
ARENA_ADDR=127.0.0.1:8080
ARENA_DATA=/var/lib/arena/arena-data.json
ARENA_SECURE_COOKIE=1
ARENA_BOT_FILL=8

# Email for sign-in codes. Any SMTP provider works.
ARENA_SMTP_HOST=smtp.example.com
ARENA_SMTP_PORT=587
ARENA_SMTP_USER=
ARENA_SMTP_PASS=
ARENA_SMTP_FROM=no-reply@example.com
