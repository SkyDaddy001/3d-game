# Copy to /etc/arena.env (chmod 600) and fill in. Never commit the real file.
ARENA_ADDR=127.0.0.1:8080
ARENA_DATA=/var/lib/arena/arena-data.json
ARENA_SECURE_COOKIE=1
ARENA_BOT_FILL=8

# Email for sign-in codes. Any SMTP provider works.
ARENA_SMTP_HOST=smtp.example.com
ARENA_SMTP_PORT=587
ARENA_SMTP_USER=
ARENA_SMTP_PASS=
ARENA_SMTP_FROM=no-reply@example.com

# Behind Caddy (or another reverse proxy you control), so rate limits see each player's address.
# Leave this off if the server is reachable directly, or callers could fake their address.
ARENA_TRUST_PROXY=1

# Backups of the accounts file go to a "backups" folder next to it.
ARENA_BACKUP_HOURS=6
ARENA_BACKUP_KEEP=28

# Optional: a file of extra blocked words for usertags, one per line.
# ARENA_BLOCKED_NAMES=/etc/arena-blocked-names.txt

